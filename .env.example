# Synapse credentials for BraTS2023 data download
# Copy this file to .env and fill in your token:
#   cp .env.example .env
#
# Get your token from: https://www.synapse.org/#!PersonalAccessTokens:
SYNAPSE_AUTH_TOKEN=your_synapse_personal_access_token_here

# Weights & Biases API key for experiment tracking
# Get your key from: https://wandb.ai/authorize
WANDB_API_KEY=your_wandb_api_key_here
